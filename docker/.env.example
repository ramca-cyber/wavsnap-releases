# Pin this to an exact release such as :0.1.1 for reproducible deployments.
WAVSNAP_IMAGE=ghcr.io/ramca-cyber/wavsnap:latest

# Replace this value with at least 32 random bytes before starting WavSnap.
WAVSNAP_SERVER_TOKEN=replace-with-a-long-random-value

# Host port mapped to the container's port 3000.
WAVSNAP_PORT=3000
